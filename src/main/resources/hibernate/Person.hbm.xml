<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="ru.varino.lab1.entity.Person" table="person"
           check="length(name) > 0 AND (height IS NULL OR height > 0)">
        <id name="id" type="java.lang.Long"><generator class="identity"/></id>
        <property name="name" type="string" not-null="true"/>
        <property name="eyeColor">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ru.varino.lab1.entity.Color</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="hairColor">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ru.varino.lab1.entity.Color</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <many-to-one name="location" class="ru.varino.lab1.entity.Location" column="location_id" not-null="true" lazy="false"/>
        <property name="height" type="java.lang.Double"/>
        <property name="nationality">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ru.varino.lab1.entity.Country</param>
                <param name="useNamed">true</param>
            </type>
        </property>
    </class>
</hibernate-mapping>
