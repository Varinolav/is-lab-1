<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="ru.varino.lab1.entity.Coordinates" table="coordinates" check="x > -59">
        <id name="id" type="java.lang.Long"><generator class="identity"/></id>
        <property name="x" type="java.lang.Integer" not-null="true"/>
        <property name="y" type="float" not-null="true"/>
    </class>
</hibernate-mapping>
